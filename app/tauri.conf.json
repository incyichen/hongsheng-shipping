{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HongshengShipping",
  "version": "0.5.2",
  "identifier": "tw.hongsheng.shipping",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "泓昇海鮮 出貨對帳系統",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" }
    }
  }
}
